{
  "name": "reusable-workflows",
  "license": "UNLICENSED",
  "author": "WillBooster Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/reusable-workflows.git"
  },
  "scripts": {
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "sync": "one-way-git-sync -v -i node_modules -i renovate.jsonc -d git@github.com:WillBoosterLab/reusable-workflows.git -b main",
    "sync-force": "bun run sync --force",
    "test": "bun .github/scripts/checkRunnerPolicy.mjs && bun .github/scripts/checkTestOutput.mjs && bun .github/scripts/checkSemanticPrTitle.mjs",
    "test/ci": "bun wb test-on-ci",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@willbooster/wb": "22.29.3",
    "lefthook": "2.2.2",
    "one-way-git-sync": "6.0.51"
  }
}
